print(f"""{'=' * 48}
        Budget Tracker Program
{'=' * 48}\n""")


bills = []
total_spent = 0
expenses = [
      'Savings',
      'Food',
      'Electricity',
      'Water',
      'Transportation Expenses',
      'Essential Clothing',
      'Others...'
      ]
months = [
    'This month',
    'January',
    'February',
    'March',
    'April',
    'May',
    'June',
    'July',
    'August',
    'September',
    'October',
    'November',
    'December'
]


name = input("Enter Name: ")
print(f"Loading profile for {name}!")
budget = int(input("\nEnter budget: "))
real_budget = budget


for index, month in enumerate(months):
    print(f"[{index}] {month}")


pick_month = int(input("\nChoose month: "))






while True:
   


    print("\n=====Payments=====")
    for index, item in enumerate(expenses):
        print(f"|{index + 1}| {item}")
       
    choice = int(input("\nChoose a number: "))
   
    if 1 <= choice <= 6:
        bill_amount = float(input(f"""-Allocating to {expenses[choice - 1]}
Please enter amount: """))
        if bill_amount > 0:
            if real_budget < bill_amount:
                print("Insufficient balance")
                break
            bills.append((expenses[choice - 1], bill_amount))
            real_budget -= bill_amount
            total_spent += bill_amount
            print(f"\nBudget remaining: {real_budget}")
            conti = input("Do you want to continue (y/n): ").lower()
            if conti == 'y':
                continue
            if conti == 'n':
                break
        else:
            print("Not allowed, please try again.")
            continue
    elif choice == 7:
        others = input("Enter other expenses: ").title()    
        bill_amount = float(input(f"""-Paying {others}
Please enter amount: """))                                  
        if bill_amount > 0:
            if real_budget < bill_amount:
                print("Insufficient balance")
                break
            bills.append((others, bill_amount))
            real_budget -= bill_amount
            total_spent += bill_amount
            print(f"\nBudget remaining: {real_budget}")
            conti = input("Do you want to continue (y/n): ").lower()
            if conti == 'y':
                continue
            if conti == 'n':
                break
        else:
            print("Not allowed, please try again.")
            continue
    elif choice == 0:
        print("Finishing...\n")
    else:
        print("Invalid choice. Try again!")
        continue
   
up = (f"""\n{'=' * 48}
            TOTAL BILL
{'=' * 48}\n""")
print(up)
def percent_bar(percent):
    used = int(round(percent / 5))
    remaining = 20 - used
    return "|" + "*" * used + "-" * remaining + "|"
print(f"Name: {name}")
print(f"Used budget for: {months[pick_month]}")
for expensed, amount in bills:
    percentage = (amount / budget) * 100
    bar_chart = percent_bar(percentage)
    print(f"""{expensed:<18}: P{amount:>8.2f} {percentage:>5.1f}%
                  {bar_chart}""")


line = ("=" * 48)
print(line)
total_percentage = (total_spent / budget) * 100
remaining_percentage = (real_budget / budget) * 100


total_bar = percent_bar(total_percentage)
remaining_bar = percent_bar(remaining_percentage)


finish_1 = (f"{'Total Spent':<18}: P{total_spent:>8.2f} {total_percentage:>5.1f}% {total_bar}")
finish_2 = (f"{'Remaining Budget':<18}: P{real_budget:8.2f} {remaining_percentage:>5.1f}% {remaining_bar}")
print(finish_1)
print(finish_2)
print(f"""\n{'=' * 48}
Thank you, exiting...
{name}.txt file loaded""")








filename = (f"{name}.txt")
with open(filename, "w") as file:
    file.write(up)
    for expensed, amount in bills:
        percentage = (amount / budget) * 100
        bar_chart = percent_bar(percentage)
        uzed = (f"{expensed:<18}: P{amount:>8.2f} {percentage:>5.1f}% {bar_chart}")
        file.write(f"{uzed}\n")
    file.write(f"{line}")
    file.write(f"\n{finish_1}")
    file.write(f"\n{finish_2}")
    file.write(line)





